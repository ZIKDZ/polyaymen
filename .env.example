SECRET_KEY=change-me-to-a-random-value-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONTACT_NOTIFY_EMAIL=hello@polyaymen.com

# --- Supabase Postgres ---
# From your Supabase project: Project Settings -> Database -> Connection string (URI tab).
# Use the pooler connection string (port 6543) unless you have a specific reason to use
# the direct connection (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL_REQUIRE=True

# --- Cloudinary (media CDN) ---
# From your Cloudinary dashboard: Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Cloudflare R2 (GLB / large file storage) ---
# From Cloudflare dashboard: R2 -> Manage API Tokens -> create a token scoped
# to your bucket. Endpoint format: https://<account-id>.r2.cloudflarestorage.com
# After creating the bucket, enable public access (Settings -> Public access)
# and set R2_PUBLIC_DOMAIN to the r2.dev URL it gives you, or a custom domain.
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_DOMAIN=pub-xxxxxxxxxxxx.r2.dev
